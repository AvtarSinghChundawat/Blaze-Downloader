{
  "name": "blaze-downloader",
  "version": "0.1.0",
  "author": "Avtar",
  "private": true,
  "main": "main.js",
  "scripts": {
    "next:dev": "next dev -p 3050 --webpack",
    "dev": "concurrently \"npm run next:dev\" \"wait-on http://localhost:3050 && npm run electron\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.10",
    "lucide-react": "^0.475.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.avtar.blazedownloader",
    "productName": "Blaze Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "downloader.js",
      "icon.png",
      "out/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blaze Downloader"
    }
  }
}
